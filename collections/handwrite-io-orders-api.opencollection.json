{
  "opencollection": "1.0.0",
  "info": {
    "name": "Handwrite IO Handwriting Orders API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get an Order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.handwrite.io/v1/order/:orderId",
            "params": [
              {
                "name": "orderId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns an order by ID, including status and proof images."
        }
      ]
    }
  ],
  "bundled": true
}